#!/bin/bash

# Launch Claude Code in the sandbox for the current directory,
# creating it with this repo's kits on first use.
# Arguments go to `sbx run`, Claude's own go after `--`.


set -euo pipefail

REPO=https://github.com/zguesmi/sclaude.git
KITS=(
    --kit "git+$REPO#ref=master&dir=shell-prompt-kit"
    --kit "git+$REPO#ref=master&dir=statusline-kit"
    --kit "git+$REPO#ref=master&dir=git-guardrails-kit"
    --kit "git+$REPO#ref=master&dir=claude-config-kit"
)

# sbx resolves a sandbox by workspace, so ask it rather than re-deriving the name it would pick.
sandbox_exists() {
    sbx ls --json 2>/dev/null |
        jq -e --arg w "$PWD" \
            'any(.sandboxes[]; .agent == "claude" and (.workspaces | index($w)))' \
            >/dev/null
}

sandbox_exists || set -- "${KITS[@]}" "$@"

exec sbx run claude . "$@"
