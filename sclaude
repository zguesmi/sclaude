#!/bin/bash

# Launch Claude Code in the sandbox for the current directory, creating it on first use
# with this repo's kits and the account picked at the prompt.
# Arguments go to `sbx run`, Claude's own go after `--`.


set -euo pipefail

REPO=https://github.com/zguesmi/sclaude.git
KITS=(
    --kit "git+$REPO#ref=master&dir=shell-prompt-kit"
    --kit "git+$REPO#ref=master&dir=statusline-kit"
    --kit "git+$REPO#ref=master&dir=git-guardrails-kit"
    --kit "git+$REPO#ref=master&dir=claude-config-kit"
)
# Anthropic subscription management.
# The accounts offered at the prompt; each needs its own keyring entry.
ACCOUNTS=(personal work)
# Keyring collection holding the personal and work Claude auth tokens.
KEYRING=sclaude
KEYRING_PATH=/org/freedesktop/secrets/collection/$KEYRING
HOST=api.anthropic.com
ENV_VAR=CLAUDE_CODE_OAUTH_TOKEN

# Print with colors if attached to a terminal. The `|| VAR=` is not only the empty value: without
# it the failed `&&` would return 1 and `set -e` would kill the script off a terminal.
[ -t 2 ] && CORAL=$'\033[38;5;173m' || CORAL=
[ -t 2 ] && GREY=$'\033[90m' || GREY=
[ -t 2 ] && WHITE=$'\033[37m' || WHITE=
[ -t 2 ] && GREEN=$'\033[32m' || GREEN=
[ -t 2 ] && RED=$'\033[31m' || RED=
[ -t 2 ] && CYAN=$'\033[36m' || CYAN=
[ -t 2 ] && OFF=$'\033[0m' || OFF=

# Every line after the first — menu entries, wrapped errors — sits one indent in.
INDENT='    '

log() {
    printf "$CORAL[sclaude]$OFF $1 $2 $OFF $GREY%b$OFF\n" "$3" >&2
}
step() { log "$CYAN" '→' "$*"; }
ok() { log "$GREEN" '✓' "$*"; }
die() { log "$RED" '✗' "$*"; exit 1; }

# api-key mode seeds an apiKeyHelper and disables the claude.ai MCP connectors.
assert_no_global_anthropic_token() {
    local global_ant_secret
    global_ant_secret=$(sbx secret ls |
        awk '/^CUSTOM SECRETS/ { exit }
             $1 == "(global)" && tolower($3) ~ /anthropic/ { print $3; exit }') ||
        die "cannot read \`sbx secret ls\`"
    [ -z "$global_ant_secret" ] ||
        die "global secret $WHITE$global_ant_secret$GREY forces anthropic api-key mode; remove it first"
}

# Accounts that already have a sandbox for this directory, space-padded so a whole-word
# `case` match cannot hit a substring. One `sbx ls` serves both the default and the
# create-or-attach decision.
existing_accounts() {
    local dir=$1 name account out=' '
    while read -r name; do
        for account in "${ACCOUNTS[@]}"; do
            if [ "$name" = "claude-$dir-$account" ]; then out="$out$account "; fi
        done
    done < <(sbx ls --json 2>/dev/null | jq -r '(.sandboxes // [])[].name')
    printf '%s' "$out"
}

# Ask which account this run uses; the answer goes to stdout, the menu to stderr.
# The account is the sandbox name suffix, so it is chosen on every run, not only at
# creation. Exactly one sandbox here makes its account the default; zero or two leave
# none, and an empty answer just re-asks.
select_account() {
    local existing=$1 account default='' count=0 i mark reply
    [ -t 0 ] || die "no terminal to choose an account on"

    for account in "${ACCOUNTS[@]}"; do
        case $existing in
            *" $account "*)
                count=$((count + 1))
                default=$account
                ;;
        esac
    done
    [ "$count" -eq 1 ] || default=''

    while :; do
        step 'select Claude account'
        i=0
        for account in "${ACCOUNTS[@]}"; do
            i=$((i + 1))
            mark=
            case $existing in *" $account "*) mark=" (sandbox exists)" ;; esac
            printf '%s%s. %s%s%s%s%s\n' "$INDENT" "$i" "$WHITE" "$account" "$GREY" "$mark" "$OFF" >&2
        done
        printf '%s%s' "$INDENT" "${default:+[$default] }> " >&2
        read -r reply || die 'no account chosen'

        reply=${reply:-$default}
        i=0
        for account in "${ACCOUNTS[@]}"; do
            i=$((i + 1))
            if [ "$reply" = "$i" ] || [ "$reply" = "$account" ]; then
                printf '%s' "$account"
                return
            fi
        done
    done
}

# Get the placeholder of an existing sandbox secret.
placeholder_for() {
    sbx secret ls --sandbox "$1" 2>/dev/null |
        awk -v n="$1" -v h="$HOST" -v e="$ENV_VAR" '$1 == n && $2 == h && $3 == e { print $4; exit }'
}

# Read the personal/work Claude auth token from Keyring and save it as an SBX secret.
# The sandbox only ever sees the placeholder; the proxy substitutes the token on requests
# to HOST. The secret must exist before creation — the env var is injected only then.
store_token_in_sbx() {
    local account=$1 name=$2 token placeholder err out

    step "reading $WHITE$account$GREY token from keyring $WHITE$KEYRING$GREY"
    token=$(secret-tool lookup service sclaude account "$account" 2>/dev/null) && [ -n "$token" ] || {
        err="no $WHITE$account$GREY token in keyring $WHITE$KEYRING$GREY. Mint one and store it:"
        err="$err\n$INDENT$WHITE""$ claude setup-token"
        err="$err\n$INDENT$ secret-tool store --collection=$KEYRING_PATH \\\\"
        err="$err\n$INDENT  --label='sclaude - $account' service sclaude account $account$GREY"
        die "$err"
    }

    # set-custom upserts on the placeholder, so reusing it replaces a stale token in place.
    placeholder=$(placeholder_for "$name") || placeholder=
    # printf is a builtin, so the token never reaches argv or the shell history.
    # sbx narrates the store in three lines; keep them for the failure case only.
    out=$(printf '%s' "$token" |
        sbx secret set-custom --host "$HOST" --env "$ENV_VAR" --sandbox "$name" \
            ${placeholder:+--placeholder "$placeholder"} 2>&1) ||
        die "could not store the $WHITE$account$GREY token:\n$INDENT${out//$'\n'/$'\n'$INDENT}"
    ok "token stored for $WHITE$name$GREY"
}

main() {
    local cmd dir existing account name
    # Check needed utilities
    for cmd in sbx jq secret-tool; do
        command -v "$cmd" >/dev/null || die "$WHITE$cmd$GREY is not installed"
    done
    # Global Claude token could be used silently by default, avoid that.
    assert_no_global_anthropic_token

    dir=$(basename "$PWD")
    existing=$(existing_accounts "$dir")
    account=$(select_account "$existing")
    ok "account $WHITE$account"
    # The account is the name suffix, so the name alone says which one a sandbox uses.
    name="claude-$dir-$account"
    case $existing in
        *" $account "*) ;;
        *)
            store_token_in_sbx "$account" "$name"
            set -- "${KITS[@]}" "$@"
            ;;
    esac

    exec sbx run claude . --name "$name" "$@"
}

main "$@"
